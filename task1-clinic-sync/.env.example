# Clinic Sync Service
CLAIM_API_URL=http://localhost:8001
DATABASE_PATH=data/clinic.db
SYNC_INTERVAL_SECONDS=30
LOG_LEVEL=INFO

# Mock Claim API
# Token validity in seconds (default: 3600 = 1 hour)
# MOCK_TOKEN_EXPIRY=3600
# Probability of a simulated timeout (0.0 to 1.0, default: 0.05)
# MOCK_TIMEOUT_RATE=0.05
# Rate limit: max requests per window (default: 10 per 1s)
# MOCK_RATE_LIMIT_WINDOW=1.0
# MOCK_RATE_LIMIT_MAX=10
